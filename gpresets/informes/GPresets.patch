+                java.util.List<String[]> list = PresetValidator.validar(new org.json.JSONObject(new String(java.nio.file.Files.readAllBytes(file.toPath()), java.nio.charset.StandardCharsets.UTF_8)));
+                int n = 0;
+                int n2 = 0;
+                for (String[] stringArray : list) {
+                    if ("error".equals(stringArray[0])) {
+                        ++n;
+                        continue;
+                    }
+                    if (!"aviso".equals(stringArray[0])) continue;
+                    ++n2;
+                }
+                if (n + n2 == 0) {
+                    return;
+                }
+                this.logger.log(String.format("Revision del preset: %d errores, %d avisos", n, n2), n > 0 ? "red" : "orange");
+                int n3 = 0;
+                for (String[] stringArray : list) {
+                    if ("info".equals(stringArray[0])) continue;
+                    if (n3++ >= 12) break;
+                    this.logger.log("  [" + stringArray[0] + "] " + stringArray[1], "orange");
+                }
+                if (n > 0) {
+                    this.sendVisualChatInfo("ERROR: el preset tiene " + n + " errores (mira el registro)");
+                }
