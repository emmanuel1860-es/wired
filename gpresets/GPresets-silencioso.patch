+    // ---- menos ruido en el chat: solo se filtra el susurro al cliente (el resto de G-Presets recibe el texto completo) ----
+    private volatile long ultimoSusurro = 0L;
+    private static final java.util.regex.Pattern SUSURRO_RUIDO = java.util.regex.Pattern.compile(
+        "^(Colocando|Configurando|Ajustando|Importando|Exportando|Leyendo|Quitar: recogiendo|Wired |Fetching|Placing)",
+        java.util.regex.Pattern.CASE_INSENSITIVE);
+    private static final java.util.regex.Pattern SUSURRO_IMPORTANTE = java.util.regex.Pattern.compile(
+        "^(ERROR|Error|No pude|No se pudo|No hay|No puedes|No existe|Ya hay|Primero|Solo el|Uso:|Haz clic|Select the|Enter |Invalid|Aborted|G-Presets:|Omitidos|Ojo:|Ni acomodando|Tal como esta|ANTES DE COLOCAR|Baldosa|Memoria de furnis|Firmas|Leer:|Atuendos|Paredes|Quitar|Texto:|Altura|Margen|Modo:|Opciones para|Para fijar)"
+        + "|importado correctamente|importado con omisiones|Exported|cancelad|Listo|Piso aplicado|Plano recortado|Sala recortada|Diagnostico guardado");
+
+    private boolean debeSusurrar(String string) {
+        if (string == null) {
+            return true;
+        }
+        if (SUSURRO_RUIDO.matcher(string).find()) {
+            return false;
+        }
+        if (SUSURRO_IMPORTANTE.matcher(string).find()) {
+            return true;
+        }
+        long l = System.currentTimeMillis();
+        if (l - this.ultimoSusurro < 3000L) {
+            return false;
+        }
+        this.ultimoSusurro = l;
+        return true;
+    }
+
+    // ---- revision silenciosa del preset al elegirlo: solo habla si hay problemas (en el registro) y susurra solo ante errores ----
+    private void revisarPreset(String string) {
+        new Thread(() -> {
+            try {
+                File file = new File(PresetConfigUtils.presetPath(), string + ".json");
+                java.util.List<String[]> list = PresetValidator.validar(new org.json.JSONObject(new String(java.nio.file.Files.readAllBytes(file.toPath()), java.nio.charset.StandardCharsets.UTF_8)));
+                int n = 0;
+                int n2 = 0;
+                for (String[] stringArray : list) {
+                    if ("error".equals(stringArray[0])) {
+                        ++n;
+                        continue;
+                    }
+                    if (!"aviso".equals(stringArray[0])) continue;
+                    ++n2;
+                }
+                if (n + n2 == 0) {
+                    return;
+                }
+                this.logger.log(String.format("Revision del preset: %d errores, %d avisos", n, n2), n > 0 ? "red" : "orange");
+                int n3 = 0;
+                for (String[] stringArray : list) {
+                    if ("info".equals(stringArray[0])) continue;
+                    if (n3++ >= 12) break;
+                    this.logger.log("  [" + stringArray[0] + "] " + stringArray[1], "orange");
+                }
+                if (n > 0) {
+                    this.sendVisualChatInfo("ERROR: el preset tiene " + n + " errores (mira el registro)");
+                }
+            }
+            catch (Exception exception) {
+                // la revision es opcional: si falla no se dice nada
+            }
+        }, "PresetReview").start();
+    }
+
